[Unit]
Description=School site (gunicorn)
After=network.target postgresql.service

[Service]
User=school
Group=school
WorkingDirectory=/srv/school-site/current
EnvironmentFile=/srv/school-site/.env
RuntimeDirectory=school-site
ExecStart=/srv/school-site/venv/bin/gunicorn config.wsgi:application --workers 3 --bind unix:/run/school-site/gunicorn.sock --access-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
