# Скопируйте в /srv/school-site/.env и заполните. Файл .env НЕ коммитится.
DJANGO_SECRET_KEY=change-me-to-50-random-chars
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=school.example.by
DJANGO_CSRF_TRUSTED_ORIGINS=https://school.example.by
POSTGRES_DB=school_prod
POSTGRES_USER=school
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# ИИ-помощник Мася (этап 2). Ключ берётся только отсюда, в git не попадает.
GEMINI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
# AI_PROVIDER=gemini            # gemini | openrouter | fake (пусто = gemini при наличии ключа)
# GEMINI_BASE_URL=              # свой адрес-прокси с OpenAI-совместимым API, если прямой доступ закрыт
# AI_HTTPS_PROXY=               # http(s)-прокси для исходящих запросов к ИИ
# OPENROUTER_API_KEY=           # запасной путь через OpenRouter (модель google/<AI_MODEL>)
# AI_MONTHLY_BUDGET_USD=3

# Недельный отчёт родителю в Telegram (этап 2). Отдельный бот, не токен другого бота.
TELEGRAM_REPORT_BOT_TOKEN=
# SITE_URL=https://school.example.by
